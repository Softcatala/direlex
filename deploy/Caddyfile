{
	admin off
	auto_https off
}

:80

root * /usr/share/caddy

header -Server

# Static assets are versioned by the generated pages and can be cached forever.
@static path /css/* /js/* /img/* /favicon.svg
header @static Cache-Control "public, max-age=31536000, immutable"

# Clean URLs: /lema/abril -> /lema/abril.html
try_files {path} {path}.html

file_server {
	precompressed br gzip
}

handle_errors 404 {
	header Cache-Control "no-store"
	rewrite * /404.html
	file_server {
		precompressed br gzip
	}
}
